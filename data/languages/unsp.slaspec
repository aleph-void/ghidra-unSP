# ------------------------------------------------------------------------------------------
# CALL / GOTO (22 bit absolute)
FarAddr: addr is (op0=0xf & A9=0 & op1=1 & imm6) ; imm16 [ addr = (imm6 << 16) | imm16; ] { export *[ram]:3 addr; }
GotoAddr: addr is (op0=0xf & Av=7 & op1=2 & imm6) ; imm16 [ addr = (imm6 << 16) | imm16; ] { export *[ram]:3 addr; }
:call FarAddr is FarAddr { local rp:3 = inst_next; rp = rp >> 1; local r:2 = rp:2; local ad:3 = zext(sp); *[ram]:2 ad = r; sp = sp - 1; local s:2; srnow(s); ad = zext(sp); *[ram]:2 ad = s; sp = sp - 1; call FarAddr; }
:goto GotoAddr is GotoAddr { goto GotoAddr; }
:call "mr" is op0=0xf & op1=5 & Nhi=1 & Bv=1 { local rp:3 = inst_next; rp = rp >> 1; local r:2 = rp:2; local ad:3 = zext(sp); *[ram]:2 ad = r; sp = sp - 1; local s:2; srnow(s); ad = zext(sp); *[ram]:2 ad = s; sp = sp - 1; local t:3 = (zext(r4 & 0x3f) << 16) | zext(r3); call [t]; }
:goto "mr" is op0=0xf & Av=7 & op1=3 { local t:3 = (zext(r4 & 0x3f) << 16) | zext(r3); goto [t]; }

# ------------------------------------------------------------------------------------------
# Multiplication: MR = r4:r3
MulN: "16" is muln=0 { }
MulN: muln is muln { }
