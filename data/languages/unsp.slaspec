# ------------------------------------------------------------------------------------------
# Data segment, flag register, interrupt control, break, nop, division
:"ds" "=" imm6 is op0=0xf & Av=7 & op1=0 & imm6 { ds = imm6; }
:^RsW "=" "ds" is op0=0xf & Av!=7 & op1=0 & N=4 & RsW & PostB { build RsW; RsW = zext(ds); build PostB; }
:"ds" "=" RsV is op0=0xf & Av!=7 & op1=0 & N=5 & RsV { build RsV; local t:2 = RsV; ds = t:1; }
:^RsW "=" "fr" is op0=0xf & Av!=7 & op1=0 & N=6 & RsW & PostB { build RsW; RsW = fr; build PostB; }
:"fr" "=" RsV is op0=0xf & Av!=7 & op1=0 & N=7 & RsV { build RsV; fr = RsV; }
:int "off" is op0=0xf & op1=5 & imm6=0x0 { irq = 0; fiq = 0; }
:int "irq" is op0=0xf & op1=5 & imm6=0x1 { irq = 1; fiq = 0; }
:int "fiq" is op0=0xf & op1=5 & imm6=0x2 { irq = 0; fiq = 1; }
:int "fiq,irq" is op0=0xf & op1=5 & imm6=0x3 { irq = 1; fiq = 1; }
:fir_mov "on" is op0=0xf & op1=5 & imm6=0x4 { fir_mov = 1; }
:fir_mov "off" is op0=0xf & op1=5 & imm6=0x5 { fir_mov = 0; }
:fraction "off" is op0=0xf & op1=5 & imm6=0x6 { fraction = 0; }
:fraction "on" is op0=0xf & op1=5 & imm6=0x7 { fraction = 1; }
:irq "off" is op0=0xf & op1=5 & imm6=0x8 { irq = 0; }
:irq "on" is op0=0xf & op1=5 & imm6=0x9 { irq = 1; }
:secbank "off" is op0=0xf & op1=5 & imm6=0xa { sec_bank = 0; }
:secbank "on" is op0=0xf & op1=5 & imm6=0xb { sec_bank = 1; }
:fiq "off" is op0=0xf & op1=5 & imm6=0xc { fiq = 0; }
:irqnest "off" is op0=0xf & op1=5 & imm6=0xd { irqnest = 0; }
:fiq "on" is op0=0xf & op1=5 & imm6=0xe { fiq = 1; }
:irqnest "on" is op0=0xf & op1=5 & imm6=0xf { irqnest = 1; }
:"break" is op0=0xf & op1=5 & Nhi=1 & Bv=0 { local rp:3 = inst_next; rp = rp >> 1; local r:2 = rp:2; local ad:3 = zext(sp); *[ram]:2 ad = r; sp = sp - 1; local s:2; srnow(s); ad = zext(sp); *[ram]:2 ad = s; sp = sp - 1; local vec:3 = 0xfff5; local t:3 = zext(*[ram]:2 vec); call [t]; }
:"divs" "mr" "," "r2" is op0=0xf & op1=5 & Nhi=1 & Bv=2 { local m:4 = (zext(r4) << 16) | zext(r3); local o:4 = divs_op(m, r2); r3 = o:2; r4 = o(2); }
:"divq" "mr" "," "r2" is op0=0xf & op1=5 & Nhi=1 & Bv=3 { local m:4 = (zext(r4) << 16) | zext(r3); local o:4 = divq_op(m, r2); r3 = o:2; r4 = o(2); }
:"r2" "=" "exp" "r4" is op0=0xf & op1=5 & Nhi=1 & Bv=4 { r2 = exp_op(r4); }
:"nop" is op0=0xf & op1=5 & Nhi=1 & Bv=5 { }
