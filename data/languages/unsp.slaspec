# ALU operations, one-word forms: rd op= operand
# op1<2 with Av=7 is a conditional jump (below)
:^RdW "+=" Opd is op0=0x0 & RdW & RdV & Opd { build Opd; build RdV; local va:2 = RdV; local vb:2 = Opd; local res:2 = va + vb; C_flag = carry(va, vb); setNZ(res); S_flag = N_flag ^ scarry(va, vb); RdW = res; }
:^RdV "+=" Opd is op0=0x0 & Av=7 & RdV & Opd { build Opd; build RdV; local va:2 = RdV; local vb:2 = Opd; local res:2 = va + vb; local tgt:3; pagetarget(tgt, res); goto [tgt]; }
:^RdW "+=" Opd "," "carry" is op0=0x1 & RdW & RdV & Opd { build Opd; build RdV; local va:2 = RdV; local vb:2 = Opd; local cin:4 = zext(C_flag); local t:4 = zext(va) + zext(vb) + cin; local ts:4 = sext(va) + sext(vb) + cin; local res:2 = t:2; C_flag = t[16,1]; setNZ(res); S_flag = ts s< 0; RdW = res; }
