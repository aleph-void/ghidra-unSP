# ------------------------------------------------------------------------------------------
# Shifts by a register amount (u'nSP 1.3 / 2.0): semantics not documented, modelled as pcodeops
:^RdW "=" RdD "asr" RsV is op0=0xe & op1=4 & bit3=1 & bfn=0 & RdW & RdD & RdV & RsV { build RdV; build RsV; RdW = asr_op(RdV, RsV); }
:^RdV "=" RdD "asr" RsV is op0=0xe & op1=4 & bit3=1 & bfn=0 & Av=7 & RdD & RdV & RsV { build RdV; build RsV; local res:2 = asr_op(RdV, RsV); local tgt:3; pagetarget(tgt, res); goto [tgt]; }
:^RdW "=" RdD "asror" RsV is op0=0xe & op1=4 & bit3=1 & bfn=1 & RdW & RdD & RdV & RsV { build RdV; build RsV; RdW = asror_op(RdV, RsV); }
:^RdV "=" RdD "asror" RsV is op0=0xe & op1=4 & bit3=1 & bfn=1 & Av=7 & RdD & RdV & RsV { build RdV; build RsV; local res:2 = asror_op(RdV, RsV); local tgt:3; pagetarget(tgt, res); goto [tgt]; }
:^RdW "=" RdD "lsl" RsV is op0=0xe & op1=4 & bit3=1 & bfn=2 & RdW & RdD & RdV & RsV { build RdV; build RsV; RdW = lsl_op(RdV, RsV); }
:^RdV "=" RdD "lsl" RsV is op0=0xe & op1=4 & bit3=1 & bfn=2 & Av=7 & RdD & RdV & RsV { build RdV; build RsV; local res:2 = lsl_op(RdV, RsV); local tgt:3; pagetarget(tgt, res); goto [tgt]; }
:^RdW "=" RdD "lslor" RsV is op0=0xe & op1=4 & bit3=1 & bfn=3 & RdW & RdD & RdV & RsV { build RdV; build RsV; RdW = lslor_op(RdV, RsV); }
:^RdV "=" RdD "lslor" RsV is op0=0xe & op1=4 & bit3=1 & bfn=3 & Av=7 & RdD & RdV & RsV { build RdV; build RsV; local res:2 = lslor_op(RdV, RsV); local tgt:3; pagetarget(tgt, res); goto [tgt]; }
:^RdW "=" RdD "lsr" RsV is op0=0xe & op1=5 & bit3=1 & bfn=0 & RdW & RdD & RdV & RsV { build RdV; build RsV; RdW = lsr_op(RdV, RsV); }
:^RdV "=" RdD "lsr" RsV is op0=0xe & op1=5 & bit3=1 & bfn=0 & Av=7 & RdD & RdV & RsV { build RdV; build RsV; local res:2 = lsr_op(RdV, RsV); local tgt:3; pagetarget(tgt, res); goto [tgt]; }
:^RdW "=" RdD "lsror" RsV is op0=0xe & op1=5 & bit3=1 & bfn=1 & RdW & RdD & RdV & RsV { build RdV; build RsV; RdW = lsror_op(RdV, RsV); }
:^RdV "=" RdD "lsror" RsV is op0=0xe & op1=5 & bit3=1 & bfn=1 & Av=7 & RdD & RdV & RsV { build RdV; build RsV; local res:2 = lsror_op(RdV, RsV); local tgt:3; pagetarget(tgt, res); goto [tgt]; }
:^RdW "=" RdD "rol" RsV is op0=0xe & op1=5 & bit3=1 & bfn=2 & RdW & RdD & RdV & RsV { build RdV; build RsV; RdW = rol_op(RdV, RsV); }
:^RdV "=" RdD "rol" RsV is op0=0xe & op1=5 & bit3=1 & bfn=2 & Av=7 & RdD & RdV & RsV { build RdV; build RsV; local res:2 = rol_op(RdV, RsV); local tgt:3; pagetarget(tgt, res); goto [tgt]; }
:^RdW "=" RdD "ror" RsV is op0=0xe & op1=5 & bit3=1 & bfn=3 & RdW & RdD & RdV & RsV { build RdV; build RsV; RdW = ror_op(RdV, RsV); }
