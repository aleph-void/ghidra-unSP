:^RdW "-=" Opd "," "carry" is op0=0x3 & RdW & RdV & Opd { build Opd; build RdV; local va:2 = RdV; local vb:2 = Opd; local cin:4 = zext(C_flag); local nb:2 = ~vb; local t:4 = zext(va) + zext(nb) + cin; local ts:4 = sext(va) + sext(nb) + cin; local res:2 = t:2; C_flag = t[16,1]; setNZ(res); S_flag = ts s< 0; RdW = res; }
