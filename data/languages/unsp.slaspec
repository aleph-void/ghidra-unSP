:"[" ^ imm16 ^ "]" "=" RdV is (op0=0xd & op1=4 & N=3 & Av=7 & Bv=7 & RdV & RsV) ; imm16 { build RdV; build RsV; local va:2 = RsV; local vb:2 = RdV; local ma:3 = imm16; local res:2 = vb; *[ram]:2 ma = res; }

# ------------------------------------------------------------------------------------------
# Jumps: PC-relative, 6 bit displacement (Av=7, op1=0 forward, op1=1 backward)
RelP6: addr is imm6 [ addr = inst_next + imm6; ] { export *[ram]:3 addr; }
RelN6: addr is imm6 [ addr = inst_next - imm6; ] { export *[ram]:3 addr; }
:jb RelP6 is op0=0x0 & Av=7 & op1=0 & RelP6 { if (C_flag == 0) goto RelP6; }
:jb RelN6 is op0=0x0 & Av=7 & op1=1 & RelN6 { if (C_flag == 0) goto RelN6; }
:jae RelP6 is op0=0x1 & Av=7 & op1=0 & RelP6 { if (C_flag == 1) goto RelP6; }
:jae RelN6 is op0=0x1 & Av=7 & op1=1 & RelN6 { if (C_flag == 1) goto RelN6; }
:jge RelP6 is op0=0x2 & Av=7 & op1=0 & RelP6 { if (S_flag == 0) goto RelP6; }
:jge RelN6 is op0=0x2 & Av=7 & op1=1 & RelN6 { if (S_flag == 0) goto RelN6; }
:jl RelP6 is op0=0x3 & Av=7 & op1=0 & RelP6 { if (S_flag == 1) goto RelP6; }
:jl RelN6 is op0=0x3 & Av=7 & op1=1 & RelN6 { if (S_flag == 1) goto RelN6; }
:jne RelP6 is op0=0x4 & Av=7 & op1=0 & RelP6 { if (Z_flag == 0) goto RelP6; }
:jne RelN6 is op0=0x4 & Av=7 & op1=1 & RelN6 { if (Z_flag == 0) goto RelN6; }
:je RelP6 is op0=0x5 & Av=7 & op1=0 & RelP6 { if (Z_flag == 1) goto RelP6; }
:je RelN6 is op0=0x5 & Av=7 & op1=1 & RelN6 { if (Z_flag == 1) goto RelN6; }
:jpl RelP6 is op0=0x6 & Av=7 & op1=0 & RelP6 { if (N_flag == 0) goto RelP6; }
:jpl RelN6 is op0=0x6 & Av=7 & op1=1 & RelN6 { if (N_flag == 0) goto RelN6; }
:jmi RelP6 is op0=0x7 & Av=7 & op1=0 & RelP6 { if (N_flag == 1) goto RelP6; }
:jmi RelN6 is op0=0x7 & Av=7 & op1=1 & RelN6 { if (N_flag == 1) goto RelN6; }
:jbe RelP6 is op0=0x8 & Av=7 & op1=0 & RelP6 { if ((Z_flag == 1) || (C_flag == 0)) goto RelP6; }
:jbe RelN6 is op0=0x8 & Av=7 & op1=1 & RelN6 { if ((Z_flag == 1) || (C_flag == 0)) goto RelN6; }
:ja RelP6 is op0=0x9 & Av=7 & op1=0 & RelP6 { if ((Z_flag == 0) && (C_flag == 1)) goto RelP6; }
:ja RelN6 is op0=0x9 & Av=7 & op1=1 & RelN6 { if ((Z_flag == 0) && (C_flag == 1)) goto RelN6; }
:jle RelP6 is op0=0xa & Av=7 & op1=0 & RelP6 { if ((Z_flag == 1) || (S_flag == 1)) goto RelP6; }
:jle RelN6 is op0=0xa & Av=7 & op1=1 & RelN6 { if ((Z_flag == 1) || (S_flag == 1)) goto RelN6; }
:jg RelP6 is op0=0xb & Av=7 & op1=0 & RelP6 { if ((Z_flag == 0) && (S_flag == 0)) goto RelP6; }
:jg RelN6 is op0=0xb & Av=7 & op1=1 & RelN6 { if ((Z_flag == 0) && (S_flag == 0)) goto RelN6; }
:jvc RelP6 is op0=0xc & Av=7 & op1=0 & RelP6 { if (N_flag == S_flag) goto RelP6; }
:jvc RelN6 is op0=0xc & Av=7 & op1=1 & RelN6 { if (N_flag == S_flag) goto RelN6; }
:jvs RelP6 is op0=0xd & Av=7 & op1=0 & RelP6 { if (N_flag != S_flag) goto RelP6; }
:jvs RelN6 is op0=0xd & Av=7 & op1=1 & RelN6 { if (N_flag != S_flag) goto RelN6; }
:jmp RelP6 is op0=0xe & Av=7 & op1=0 & RelP6 { goto RelP6; }
:jmp RelN6 is op0=0xe & Av=7 & op1=1 & RelN6 { goto RelN6; }

# ------------------------------------------------------------------------------------------
# PUSH / POP (op1=2) and returns
# push Rlo, Rhi to [Rs]: stores Rhi first, post-decrement; pop restores Rlo..Rhi with pre-increment.
# POP of SR and PC is a far return; PC alone returns inside the current segment.
:push "r1" "," "sp" "to" "[" ^ PtrW ^ "]" is op0=0xd & op1=2 & Av=0 & N=0 & PtrW { build PtrW; local v:2; local ad:3; }
:pop "r1" "," "sp" "from" "[" ^ PtrW ^ "]" is op0=0x9 & op1=2 & Av=0 & N=0 & PtrW { build PtrW; local ad:3; }
:push "r2" "," "r1" "to" "[" ^ PtrW ^ "]" is op0=0xd & op1=2 & Av=1 & N=0 & PtrW { build PtrW; local v:2; local ad:3; }
:pop "r2" "," "r1" "from" "[" ^ PtrW ^ "]" is op0=0x9 & op1=2 & Av=1 & N=0 & PtrW { build PtrW; local ad:3; }
:push "r3" "," "r2" "to" "[" ^ PtrW ^ "]" is op0=0xd & op1=2 & Av=2 & N=0 & PtrW { build PtrW; local v:2; local ad:3; }
:pop "r3" "," "r2" "from" "[" ^ PtrW ^ "]" is op0=0x9 & op1=2 & Av=2 & N=0 & PtrW { build PtrW; local ad:3; }
:push "r4" "," "r3" "to" "[" ^ PtrW ^ "]" is op0=0xd & op1=2 & Av=3 & N=0 & PtrW { build PtrW; local v:2; local ad:3; }
:pop "r4" "," "r3" "from" "[" ^ PtrW ^ "]" is op0=0x9 & op1=2 & Av=3 & N=0 & PtrW { build PtrW; local ad:3; }
:push "bp" "," "r4" "to" "[" ^ PtrW ^ "]" is op0=0xd & op1=2 & Av=4 & N=0 & PtrW { build PtrW; local v:2; local ad:3; }
:pop "bp" "," "r4" "from" "[" ^ PtrW ^ "]" is op0=0x9 & op1=2 & Av=4 & N=0 & PtrW { build PtrW; local ad:3; }
:push "sr" "," "bp" "to" "[" ^ PtrW ^ "]" is op0=0xd & op1=2 & Av=5 & N=0 & PtrW { build PtrW; local v:2; local ad:3; }
:pop "sr" "," "bp" "from" "[" ^ PtrW ^ "]" is op0=0x9 & op1=2 & Av=5 & N=0 & PtrW { build PtrW; local ad:3; }
:push "pc" "," "sr" "to" "[" ^ PtrW ^ "]" is op0=0xd & op1=2 & Av=6 & N=0 & PtrW { build PtrW; local v:2; local ad:3; }
:pop "pc" "," "sr" "from" "[" ^ PtrW ^ "]" is op0=0x9 & op1=2 & Av=6 & N=0 & PtrW { build PtrW; local ad:3; }
:push "sp" "," "sp" "to" "[" ^ PtrW ^ "]" is op0=0xd & op1=2 & Av=0 & N=1 & PtrW { build PtrW; local v:2; local ad:3; v = sp; ad = zext(PtrW); *[ram]:2 ad = v; PtrW = PtrW - 1; }
:pop "r1" "," "r1" "from" "[" ^ PtrW ^ "]" is op0=0x9 & op1=2 & Av=0 & N=1 & PtrW { build PtrW; local ad:3; PtrW = PtrW + 1; ad = zext(PtrW); r1 = *[ram]:2 ad; }
:push "r1" "," "r1" "to" "[" ^ PtrW ^ "]" is op0=0xd & op1=2 & Av=1 & N=1 & PtrW { build PtrW; local v:2; local ad:3; v = r1; ad = zext(PtrW); *[ram]:2 ad = v; PtrW = PtrW - 1; }
:pop "r2" "," "r2" "from" "[" ^ PtrW ^ "]" is op0=0x9 & op1=2 & Av=1 & N=1 & PtrW { build PtrW; local ad:3; PtrW = PtrW + 1; ad = zext(PtrW); r2 = *[ram]:2 ad; }
:push "r2" "," "r2" "to" "[" ^ PtrW ^ "]" is op0=0xd & op1=2 & Av=2 & N=1 & PtrW { build PtrW; local v:2; local ad:3; v = r2; ad = zext(PtrW); *[ram]:2 ad = v; PtrW = PtrW - 1; }
:pop "r3" "," "r3" "from" "[" ^ PtrW ^ "]" is op0=0x9 & op1=2 & Av=2 & N=1 & PtrW { build PtrW; local ad:3; PtrW = PtrW + 1; ad = zext(PtrW); r3 = *[ram]:2 ad; }
:push "r3" "," "r3" "to" "[" ^ PtrW ^ "]" is op0=0xd & op1=2 & Av=3 & N=1 & PtrW { build PtrW; local v:2; local ad:3; v = r3; ad = zext(PtrW); *[ram]:2 ad = v; PtrW = PtrW - 1; }
:pop "r4" "," "r4" "from" "[" ^ PtrW ^ "]" is op0=0x9 & op1=2 & Av=3 & N=1 & PtrW { build PtrW; local ad:3; PtrW = PtrW + 1; ad = zext(PtrW); r4 = *[ram]:2 ad; }
:push "r4" "," "r4" "to" "[" ^ PtrW ^ "]" is op0=0xd & op1=2 & Av=4 & N=1 & PtrW { build PtrW; local v:2; local ad:3; v = r4; ad = zext(PtrW); *[ram]:2 ad = v; PtrW = PtrW - 1; }
