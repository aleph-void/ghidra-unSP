:clrb "[" ^ RdV ^ "]", bimm is op0=0xe & op1=6 & bfn=2 & bimm & RdV { build RdV; local ad:3 = zext(RdV); local t:2 = *[ram]:2 ad; local k:2 = bimm; local m:2 = 1 << (k); t = t & ~m; *[ram]:2 ad = t; }
:clrb "ds:[" ^ RdV ^ "]", bimm is op0=0xe & op1=7 & bfn=2 & bimm & RdV { build RdV; local ad:3 = (zext(ds) << 16) | zext(RdV); local t:2 = *[ram]:2 ad; local k:2 = bimm; local m:2 = 1 << (k); t = t & ~m; *[ram]:2 ad = t; }
:clrb "[" ^ imm16 ^ "]", bimm is (op0=0xf & A9=1 & A10=0 & op1=1 & bfn=2 & bimm) ; imm16 { local i3:3 = imm16; local ad:3 = i3; local t:2 = *[ram]:2 ad; local k:2 = bimm; local m:2 = 1 << (k); t = t & ~m; *[ram]:2 ad = t; }
:clrb "ds:[" ^ imm16 ^ "]", bimm is (op0=0xf & A9=1 & A10=1 & op1=1 & bfn=2 & bimm) ; imm16 { local i3:3 = imm16; local ad:3 = (zext(ds) << 16) | i3; local t:2 = *[ram]:2 ad; local k:2 = bimm; local m:2 = 1 << (k); t = t & ~m; *[ram]:2 ad = t; }
:invb RdW, RsV is op0=0xe & op1=0 & bit3=0 & bfn=3 & RdW & RdV & RsV { build RdV; build RsV; local t:2 = RdV; local k:2 = RsV & 0xf; local m:2 = 1 << (k); t = t ^ m; RdW = t; }
:invb RdW, bimm is op0=0xe & op1=1 & bfn=3 & bimm & RdW & RdV { build RdV; local t:2 = RdV; local k:2 = bimm; local m:2 = 1 << (k); t = t ^ m; RdW = t; }
:invb "[" ^ RdV ^ "]", RsV is op0=0xe & op1=4 & bit3=0 & bfn=3 & RdV & RsV { build RdV; build RsV; local ad:3 = zext(RdV); local t:2 = *[ram]:2 ad; local k:2 = RsV & 0xf; local m:2 = 1 << (k); t = t ^ m; *[ram]:2 ad = t; }
:invb "ds:[" ^ RdV ^ "]", RsV is op0=0xe & op1=5 & bit3=0 & bfn=3 & RdV & RsV { build RdV; build RsV; local ad:3 = (zext(ds) << 16) | zext(RdV); local t:2 = *[ram]:2 ad; local k:2 = RsV & 0xf; local m:2 = 1 << (k); t = t ^ m; *[ram]:2 ad = t; }
:invb "[" ^ RdV ^ "]", bimm is op0=0xe & op1=6 & bfn=3 & bimm & RdV { build RdV; local ad:3 = zext(RdV); local t:2 = *[ram]:2 ad; local k:2 = bimm; local m:2 = 1 << (k); t = t ^ m; *[ram]:2 ad = t; }
:invb "ds:[" ^ RdV ^ "]", bimm is op0=0xe & op1=7 & bfn=3 & bimm & RdV { build RdV; local ad:3 = (zext(ds) << 16) | zext(RdV); local t:2 = *[ram]:2 ad; local k:2 = bimm; local m:2 = 1 << (k); t = t ^ m; *[ram]:2 ad = t; }
:invb "[" ^ imm16 ^ "]", bimm is (op0=0xf & A9=1 & A10=0 & op1=1 & bfn=3 & bimm) ; imm16 { local i3:3 = imm16; local ad:3 = i3; local t:2 = *[ram]:2 ad; local k:2 = bimm; local m:2 = 1 << (k); t = t ^ m; *[ram]:2 ad = t; }
