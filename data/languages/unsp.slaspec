:^RdV "=-" Opd is op0=0x6 & Av=7 & RdV & Opd { build Opd; build RdV; local va:2 = RdV; local vb:2 = Opd; local res:2 = -vb; local tgt:3; pagetarget(tgt, res); goto [tgt]; }
