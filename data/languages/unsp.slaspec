# ------------------------------------------------------------------------------------------
# Bit operations: tstb / setb / clrb / invb (u'nSP 1.2+, memory-absolute forms 2.0)
# TSTB sets Z when the tested bit is clear (u'nSP 1.1 programmer's guide convention, unverified here).
:tstb RdW, RsV is op0=0xe & op1=0 & bit3=0 & bfn=0 & RdW & RdV & RsV { build RdV; build RsV; local t:2 = RdV; local k:2 = RsV & 0xf; local m:2 = 1 << (k); Z_flag = (t & m) == 0;  }
:tstb RdW, bimm is op0=0xe & op1=1 & bfn=0 & bimm & RdW & RdV { build RdV; local t:2 = RdV; local k:2 = bimm; local m:2 = 1 << (k); Z_flag = (t & m) == 0;  }
:tstb "[" ^ RdV ^ "]", RsV is op0=0xe & op1=4 & bit3=0 & bfn=0 & RdV & RsV { build RdV; build RsV; local ad:3 = zext(RdV); local t:2 = *[ram]:2 ad; local k:2 = RsV & 0xf; local m:2 = 1 << (k); Z_flag = (t & m) == 0;  }
:tstb "ds:[" ^ RdV ^ "]", RsV is op0=0xe & op1=5 & bit3=0 & bfn=0 & RdV & RsV { build RdV; build RsV; local ad:3 = (zext(ds) << 16) | zext(RdV); local t:2 = *[ram]:2 ad; local k:2 = RsV & 0xf; local m:2 = 1 << (k); Z_flag = (t & m) == 0;  }
:tstb "[" ^ RdV ^ "]", bimm is op0=0xe & op1=6 & bfn=0 & bimm & RdV { build RdV; local ad:3 = zext(RdV); local t:2 = *[ram]:2 ad; local k:2 = bimm; local m:2 = 1 << (k); Z_flag = (t & m) == 0;  }
:tstb "ds:[" ^ RdV ^ "]", bimm is op0=0xe & op1=7 & bfn=0 & bimm & RdV { build RdV; local ad:3 = (zext(ds) << 16) | zext(RdV); local t:2 = *[ram]:2 ad; local k:2 = bimm; local m:2 = 1 << (k); Z_flag = (t & m) == 0;  }
:tstb "[" ^ imm16 ^ "]", bimm is (op0=0xf & A9=1 & A10=0 & op1=1 & bfn=0 & bimm) ; imm16 { local i3:3 = imm16; local ad:3 = i3; local t:2 = *[ram]:2 ad; local k:2 = bimm; local m:2 = 1 << (k); Z_flag = (t & m) == 0;  }
:tstb "ds:[" ^ imm16 ^ "]", bimm is (op0=0xf & A9=1 & A10=1 & op1=1 & bfn=0 & bimm) ; imm16 { local i3:3 = imm16; local ad:3 = (zext(ds) << 16) | i3; local t:2 = *[ram]:2 ad; local k:2 = bimm; local m:2 = 1 << (k); Z_flag = (t & m) == 0;  }
:setb RdW, RsV is op0=0xe & op1=0 & bit3=0 & bfn=1 & RdW & RdV & RsV { build RdV; build RsV; local t:2 = RdV; local k:2 = RsV & 0xf; local m:2 = 1 << (k); t = t | m; RdW = t; }
:setb RdW, bimm is op0=0xe & op1=1 & bfn=1 & bimm & RdW & RdV { build RdV; local t:2 = RdV; local k:2 = bimm; local m:2 = 1 << (k); t = t | m; RdW = t; }
:setb "[" ^ RdV ^ "]", RsV is op0=0xe & op1=4 & bit3=0 & bfn=1 & RdV & RsV { build RdV; build RsV; local ad:3 = zext(RdV); local t:2 = *[ram]:2 ad; local k:2 = RsV & 0xf; local m:2 = 1 << (k); t = t | m; *[ram]:2 ad = t; }
:setb "ds:[" ^ RdV ^ "]", RsV is op0=0xe & op1=5 & bit3=0 & bfn=1 & RdV & RsV { build RdV; build RsV; local ad:3 = (zext(ds) << 16) | zext(RdV); local t:2 = *[ram]:2 ad; local k:2 = RsV & 0xf; local m:2 = 1 << (k); t = t | m; *[ram]:2 ad = t; }
:setb "[" ^ RdV ^ "]", bimm is op0=0xe & op1=6 & bfn=1 & bimm & RdV { build RdV; local ad:3 = zext(RdV); local t:2 = *[ram]:2 ad; local k:2 = bimm; local m:2 = 1 << (k); t = t | m; *[ram]:2 ad = t; }
:setb "ds:[" ^ RdV ^ "]", bimm is op0=0xe & op1=7 & bfn=1 & bimm & RdV { build RdV; local ad:3 = (zext(ds) << 16) | zext(RdV); local t:2 = *[ram]:2 ad; local k:2 = bimm; local m:2 = 1 << (k); t = t | m; *[ram]:2 ad = t; }
:setb "[" ^ imm16 ^ "]", bimm is (op0=0xf & A9=1 & A10=0 & op1=1 & bfn=1 & bimm) ; imm16 { local i3:3 = imm16; local ad:3 = i3; local t:2 = *[ram]:2 ad; local k:2 = bimm; local m:2 = 1 << (k); t = t | m; *[ram]:2 ad = t; }
:setb "ds:[" ^ imm16 ^ "]", bimm is (op0=0xf & A9=1 & A10=1 & op1=1 & bfn=1 & bimm) ; imm16 { local i3:3 = imm16; local ad:3 = (zext(ds) << 16) | i3; local t:2 = *[ram]:2 ad; local k:2 = bimm; local m:2 = 1 << (k); t = t | m; *[ram]:2 ad = t; }
:clrb RdW, RsV is op0=0xe & op1=0 & bit3=0 & bfn=2 & RdW & RdV & RsV { build RdV; build RsV; local t:2 = RdV; local k:2 = RsV & 0xf; local m:2 = 1 << (k); t = t & ~m; RdW = t; }
:clrb RdW, bimm is op0=0xe & op1=1 & bfn=2 & bimm & RdW & RdV { build RdV; local t:2 = RdV; local k:2 = bimm; local m:2 = 1 << (k); t = t & ~m; RdW = t; }
